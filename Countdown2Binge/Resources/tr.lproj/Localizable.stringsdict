    <key>plural_left_to_release</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Yayınlanacak %lld bölüm kaldı</string>
            <key>other</key>
            <string>Yayınlanacak %lld bölüm kaldı</string>
        </dict>
    </dict>

    <!-- Left to drop -->
    <key>plural_left_to_drop</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Düşecek %lld bölüm kaldı</string>
            <key>other</key>
            <string>Düşecek %lld bölüm kaldı</string>
        </dict>
    </dict>

    <!-- Sync restored shows -->
    <key>plural_sync_restored</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Bulut yedeklemenizden %lld dizi geri yüklendi.</string>
            <key>other</key>
            <string>Bulut yedeklemenizden %lld dizi geri yüklendi.</string>
        </dict>
    </dict>

    <!-- Shows added (onboarding) -->
    <key>plural_shows_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld dizi eklendi. Her sezonu takip edeceğiz ve maratona hazır olduğu an sizi bilgilendireceğiz.</string>
            <key>other</key>
            <string>%lld dizi eklendi. Her sezonu takip edeceğiz ve her biri maratona hazır olduğunda sizi bilgilendireceğiz.</string>
        </dict>
    </dict>

    <!-- Premieres in days -->
    <key>plural_premieres_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld GÜN İÇİNDE BAŞLIYOR</string>
            <key>other</key>
            <string>%lld GÜN İÇİNDE BAŞLIYOR</string>
        </dict>
    </dict>

    <!-- Binge ready in days -->
    <key>plural_binge_ready_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Takip listenizde · ~%lld gün içinde maratona hazır</string>
            <key>other</key>
            <string>Takip listenizde · ~%lld gün içinde maratona hazır</string>
        </dict>
    </dict>

    <!-- Episodes aired of total -->
    <key>plural_episodes_watched</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@total@ bölümden %#@watched@ izlendi</string>
        <key>watched</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
    </dict>

    <!-- All episodes out -->
    <key>plural_all_episodes_out</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld bölümün tamamı yayında · yeni bitti</string>
            <key>other</key>
            <string>%lld bölümün tamamı yayında · yeni bitti</string>
        </dict>
    </dict>

    <!-- Follow line complete -->
    <key>plural_follow_line_complete</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld bölüm yayında — istediğiniz zaman başlayın.</string>
            <key>other</key>
            <string>%lld bölümün tamamı yayında — istediğiniz zaman başlayın.</string>
        </dict>
    </dict>

    <!-- Follow hint airing -->
    <key>plural_follow_hint_airing</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Takip edin, %lld bölümü bekleyeceğiz ve maratona hazır olduğu gün sizi uyaracağız.</string>
            <key>other</key>
            <string>Takip edin, %lld bölümün tamamını bekleyeceğiz ve maratona hazır olduğu gün sizi uyaracağız.</string>
        </dict>
    </dict>

    <!-- Share default binged -->
    <key>plural_share_binged</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld bölümü baştan sona izledim.</string>
            <key>other</key>
            <string>%lld bölümün tamamını baştan sona izledim.</string>
        </dict>
    </dict>
