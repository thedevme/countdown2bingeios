<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Episode count -->
    <key>plural_episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld bölüm</string>
            <key>other</key>
            <string>%lld bölüm</string>
        </dict>
    </dict>

    <!-- Episodes short (eps) -->
    <key>plural_eps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@eps@</string>
        <key>eps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld blm</string>
            <key>other</key>
            <string>%lld blm</string>
        </dict>
    </dict>

    <!-- Season count -->
    <key>plural_seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld sezon</string>
            <key>other</key>
            <string>%lld sezon</string>
        </dict>
    </dict>

    <!-- Show count -->
    <key>plural_shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld dizi</string>
            <key>other</key>
            <string>%lld dizi</string>
        </dict>
    </dict>

    <!-- Shows tracked -->
    <key>plural_shows_tracked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld DİZİ TAKİP EDİLİYOR</string>
            <key>other</key>
            <string>%lld DİZİ TAKİP EDİLİYOR</string>
        </dict>
    </dict>

    <!-- Days to watch -->
    <key>plural_days_to_watch</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>İzlemek için %lld gün</string>
            <key>other</key>
            <string>İzlemek için %lld gün</string>
        </dict>
    </dict>

    <!-- Days remaining -->
    <key>plural_days_remaining</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld gün kaldı</string>
            <key>other</key>
            <string>%lld gün kaldı</string>
        </dict>
    </dict>

