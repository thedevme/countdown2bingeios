    <!-- Shows added (onboarding) -->
    <key>plural_shows_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>zero</key>
            <string>لم تتم إضافة أي مسلسل. سنراقب كل موسم ونخبرك فور جاهزيته للمشاهدة.</string>
            <key>one</key>
            <string>تمت إضافة مسلسل واحد. سنراقب كل موسم ونخبرك فور جاهزيته للمشاهدة.</string>
            <key>two</key>
            <string>تمت إضافة مسلسلين. سنراقب كل موسم ونخبرك فور جاهزيتهما للمشاهدة.</string>
            <key>few</key>
            <string>تمت إضافة %lld مسلسلات. سنراقب كل موسم ونخبرك فور جاهزية كل منها للمشاهدة.</string>
            <key>many</key>
            <string>تمت إضافة %lld مسلسلًا. سنراقب كل موسم ونخبرك فور جاهزية كل منها للمشاهدة.</string>
            <key>other</key>
            <string>تمت إضافة %lld مسلسل. سنراقب كل موسم ونخبرك فور جاهزية كل منها للمشاهدة.</string>
        </dict>
    </dict>

