    <!-- Sync restored shows -->
    <key>plural_sync_restored</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>zero</key>
            <string>لم نستعد أي مسلسل من النسخة الاحتياطية السحابية.</string>
            <key>one</key>
            <string>استعدنا مسلسلًا واحدًا من النسخة الاحتياطية السحابية.</string>
            <key>two</key>
            <string>استعدنا مسلسلين من النسخة الاحتياطية السحابية.</string>
            <key>few</key>
            <string>استعدنا %lld مسلسلات من النسخة الاحتياطية السحابية.</string>
            <key>many</key>
            <string>استعدنا %lld مسلسلًا من النسخة الاحتياطية السحابية.</string>
