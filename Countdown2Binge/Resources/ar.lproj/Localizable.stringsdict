    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>zero</key>
            <string>تابع وسننتظر الحلقات، ثم ننبهك يوم جاهزيتها للمشاهدة.</string>
            <key>one</key>
            <string>تابع وسننتظر الحلقة الوحيدة، ثم ننبهك يوم جاهزيتها للمشاهدة.</string>
            <key>two</key>
            <string>تابع وسننتظر الحلقتين، ثم ننبهك يوم جاهزيتهما للمشاهدة.</string>
            <key>few</key>
            <string>تابع وسننتظر جميع الـ %lld حلقات، ثم ننبهك يوم جاهزيتها للمشاهدة.</string>
            <key>many</key>
            <string>تابع وسننتظر جميع الـ %lld حلقة، ثم ننبهك يوم جاهزيتها للمشاهدة.</string>
            <key>other</key>
