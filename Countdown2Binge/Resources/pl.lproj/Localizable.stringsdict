        <key>NSStringLocalizedFormatKey</key>
        <string>Obejrzano %#@watched@ z %#@total@ odcinków</string>
        <key>watched</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>few</key>
            <string>%lld</string>
            <key>many</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>few</key>
            <string>%lld</string>
            <key>many</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
