    <!-- Shows added (onboarding) -->
    <key>plural_shows_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Dodano %lld serial. Będziemy śledzić każdy sezon i powiadomimy Cię, gdy będzie gotowy do maratonu.</string>
            <key>few</key>
            <string>Dodano %lld seriale. Będziemy śledzić każdy sezon i powiadomimy Cię, gdy będą gotowe do maratonu.</string>
            <key>many</key>
            <string>Dodano %lld seriali. Będziemy śledzić każdy sezon i powiadomimy Cię, gdy będą gotowe do maratonu.</string>
            <key>other</key>
            <string>Dodano %lld serialu. Będziemy śledzić każdy sezon i powiadomimy Cię, gdy będą gotowe do maratonu.</string>
        </dict>
    </dict>

