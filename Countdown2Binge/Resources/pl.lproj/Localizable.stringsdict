            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>PREMIERA ZA %lld DZIEŃ</string>
            <key>few</key>
            <string>PREMIERA ZA %lld DNI</string>
            <key>many</key>
            <string>PREMIERA ZA %lld DNI</string>
            <key>other</key>
            <string>PREMIERA ZA %lld DNIA</string>
