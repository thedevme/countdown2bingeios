            <key>one</key>
            <string>%lld seizoen</string>
            <key>other</key>
            <string>%lld seizoenen</string>
        </dict>
    </dict>

    <!-- Show count -->
    <key>plural_shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld serie</string>
            <key>other</key>
            <string>%lld series</string>
        </dict>
    </dict>

    <!-- Shows tracked -->
    <key>plural_shows_tracked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
