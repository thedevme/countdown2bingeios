        </dict>
    </dict>

    <!-- Episodes aired of total -->
    <key>plural_episodes_watched</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@total@ 중 %#@watched@ 시청 완료</string>
        <key>watched</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld화</string>
        </dict>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld화</string>
        </dict>
    </dict>

    <!-- All episodes out -->
    <key>plural_all_episodes_out</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>전체 %lld화 공개 완료 · 방금 종영</string>
        </dict>
    </dict>

    <!-- Follow line complete -->
    <key>plural_follow_line_complete</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>전체 %lld화 공개 완료 — 원할 때 시작하세요.</string>
        </dict>
    </dict>

    <!-- Follow hint airing -->
    <key>plural_follow_hint_airing</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>팔로우하면 전체 %lld화 공개를 기다렸다가 몰아보기 가능한 날 알려드립니다.</string>
        </dict>
    </dict>

    <!-- Share default binged -->
    <key>plural_share_binged</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
