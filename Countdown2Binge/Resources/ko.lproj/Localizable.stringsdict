            <key>other</key>
            <string>시즌 %lld</string>
        </dict>
    </dict>

    <!-- Show count -->
    <key>plural_shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
