<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Episode count -->
    <key>plural_episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld화</string>
        </dict>
    </dict>

    <!-- Episodes short (eps) -->
    <key>plural_eps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@eps@</string>
        <key>eps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld화</string>
        </dict>
    </dict>

    <!-- Season count -->
    <key>plural_seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
