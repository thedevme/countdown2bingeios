        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld Serie hinzugefügt. Wir beobachten jede Staffel und benachrichtigen dich, sobald sie zum Marathon bereit ist.</string>
            <key>other</key>
            <string>%lld Serien hinzugefügt. Wir beobachten jede Staffel und benachrichtigen dich, sobald jede zum Marathon bereit ist.</string>
        </dict>
    </dict>

