        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Folge und wir warten auf die %lld Folge und benachrichtigen dich dann, wenn sie marathonbereit ist.</string>
            <key>other</key>
            <string>Folge und wir warten auf alle %lld Folgen und benachrichtigen dich dann, wenn sie marathonbereit ist.</string>
        </dict>
    </dict>

    <!-- Share default binged -->
