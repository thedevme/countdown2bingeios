<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Episode count -->
    <key>plural_episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld épisode</string>
            <key>other</key>
            <string>%lld épisodes</string>
        </dict>
    </dict>

    <!-- Episodes short (eps) -->
    <key>plural_eps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@eps@</string>
        <key>eps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld ép</string>
            <key>other</key>
            <string>%lld éps</string>
        </dict>
    </dict>

    <!-- Season count -->
    <key>plural_seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld saison</string>
            <key>other</key>
            <string>%lld saisons</string>
        </dict>
    </dict>

    <!-- Show count -->
    <key>plural_shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld série</string>
            <key>other</key>
            <string>%lld séries</string>
        </dict>
    </dict>

    <!-- Shows tracked -->
    <key>plural_shows_tracked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld SÉRIE SUIVIE</string>
            <key>other</key>
            <string>%lld SÉRIES SUIVIES</string>
        </dict>
    </dict>

    <!-- Days to watch -->
    <key>plural_days_to_watch</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld jour pour regarder</string>
            <key>other</key>
            <string>%lld jours pour regarder</string>
        </dict>
    </dict>

    <!-- Days remaining -->
    <key>plural_days_remaining</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld jour restant</string>
            <key>other</key>
            <string>%lld jours restants</string>
        </dict>
    </dict>

    <!-- Left to release -->
    <key>plural_left_to_release</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld restant à sortir</string>
            <key>other</key>
            <string>%lld restants à sortir</string>
        </dict>
    </dict>

    <!-- Left to drop -->
    <key>plural_left_to_drop</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld restant à diffuser</string>
            <key>other</key>
            <string>%lld restants à diffuser</string>
        </dict>
    </dict>

    <!-- Sync restored shows -->
    <key>plural_sync_restored</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Nous avons restauré %lld série depuis votre sauvegarde cloud.</string>
            <key>other</key>
            <string>Nous avons restauré %lld séries depuis votre sauvegarde cloud.</string>
        </dict>
    </dict>

    <!-- Shows added (onboarding) -->
    <key>plural_shows_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld série ajoutée. Nous surveillerons chaque saison et vous préviendrons dès qu'elle sera prête pour le marathon.</string>
            <key>other</key>
            <string>%lld séries ajoutées. Nous surveillerons chaque saison et vous préviendrons dès que chacune sera prête pour le marathon.</string>
        </dict>
    </dict>

    <!-- Premieres in days -->
    <key>plural_premieres_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>PREMIÈRE DANS %lld JOUR</string>
            <key>other</key>
            <string>PREMIÈRE DANS %lld JOURS</string>
        </dict>
    </dict>

    <!-- Binge ready in days -->
    <key>plural_binge_ready_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Dans votre liste · prêt pour le marathon dans ~%lld jour</string>
            <key>other</key>
            <string>Dans votre liste · prêt pour le marathon dans ~%lld jours</string>
        </dict>
    </dict>

    <!-- Episodes aired of total -->
    <key>plural_episodes_watched</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@watched@ sur %#@total@ épisodes regardés</string>
        <key>watched</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
    </dict>

    <!-- All episodes out -->
    <key>plural_all_episodes_out</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>L'épisode %lld est sorti · vient de se terminer</string>
            <key>other</key>
            <string>Les %lld épisodes sont sortis · vient de se terminer</string>
        </dict>
    </dict>

    <!-- Follow line complete -->
    <key>plural_follow_line_complete</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>L'épisode %lld est sorti — commencez quand vous voulez.</string>
            <key>other</key>
            <string>Les %lld épisodes sont sortis — commencez quand vous voulez.</string>
        </dict>
    </dict>

    <!-- Follow hint airing -->
    <key>plural_follow_hint_airing</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Suivez et nous attendrons l'épisode %lld, puis nous vous alerterons le jour où il sera prêt pour le marathon.</string>
            <key>other</key>
            <string>Suivez et nous attendrons les %lld épisodes, puis nous vous alerterons le jour où ils seront prêts pour le marathon.</string>
        </dict>
    </dict>

    <!-- Share default binged -->
    <key>plural_share_binged</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Je viens de regarder l'épisode %lld du début à la fin en marathon.</string>
            <key>other</key>
            <string>Je viens de regarder les %lld épisodes du début à la fin en marathon.</string>
        </dict>
    </dict>
</dict>
</plist>
