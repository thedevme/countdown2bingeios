<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Episode count -->
    <key>plural_episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld эпизод</string>
            <key>few</key>
            <string>%lld эпизода</string>
            <key>many</key>
            <string>%lld эпизодов</string>
            <key>other</key>
            <string>%lld эпизода</string>
        </dict>
    </dict>

    <!-- Episodes short (eps) -->
    <key>plural_eps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@eps@</string>
        <key>eps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld эп.</string>
            <key>few</key>
            <string>%lld эп.</string>
            <key>many</key>
            <string>%lld эп.</string>
            <key>other</key>
            <string>%lld эп.</string>
        </dict>
    </dict>

    <!-- Season count -->
    <key>plural_seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld сезон</string>
            <key>few</key>
            <string>%lld сезона</string>
            <key>many</key>
            <string>%lld сезонов</string>
            <key>other</key>
            <string>%lld сезона</string>
        </dict>
    </dict>

    <!-- Show count -->
    <key>plural_shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld сериал</string>
            <key>few</key>
            <string>%lld сериала</string>
            <key>many</key>
            <string>%lld сериалов</string>
            <key>other</key>
            <string>%lld сериала</string>
        </dict>
    </dict>

    <!-- Shows tracked -->
    <key>plural_shows_tracked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld СЕРИАЛ ОТСЛЕЖИВАЕТСЯ</string>
            <key>few</key>
            <string>%lld СЕРИАЛА ОТСЛЕЖИВАЮТСЯ</string>
            <key>many</key>
            <string>%lld СЕРИАЛОВ ОТСЛЕЖИВАЕТСЯ</string>
            <key>other</key>
            <string>%lld СЕРИАЛА ОТСЛЕЖИВАЕТСЯ</string>
        </dict>
    </dict>

    <!-- Days to watch -->
    <key>plural_days_to_watch</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld день до просмотра</string>
            <key>few</key>
            <string>%lld дня до просмотра</string>
            <key>many</key>
            <string>%lld дней до просмотра</string>
            <key>other</key>
            <string>%lld дня до просмотра</string>
        </dict>
    </dict>

    <!-- Days remaining -->
    <key>plural_days_remaining</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Остался %lld день</string>
            <key>few</key>
            <string>Осталось %lld дня</string>
            <key>many</key>
            <string>Осталось %lld дней</string>
            <key>other</key>
            <string>Осталось %lld дня</string>
        </dict>
    </dict>

    <!-- Left to release -->
    <key>plural_left_to_release</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Осталось выпустить %lld</string>
            <key>few</key>
            <string>Осталось выпустить %lld</string>
            <key>many</key>
            <string>Осталось выпустить %lld</string>
            <key>other</key>
            <string>Осталось выпустить %lld</string>
        </dict>
    </dict>

    <!-- Left to drop -->
    <key>plural_left_to_drop</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Осталось выйти %lld</string>
            <key>few</key>
            <string>Осталось выйти %lld</string>
            <key>many</key>
            <string>Осталось выйти %lld</string>
            <key>other</key>
            <string>Осталось выйти %lld</string>
        </dict>
    </dict>

    <!-- Sync restored shows -->
    <key>plural_sync_restored</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Мы восстановили %lld сериал из вашей облачной резервной копии.</string>
            <key>few</key>
            <string>Мы восстановили %lld сериала из вашей облачной резервной копии.</string>
            <key>many</key>
            <string>Мы восстановили %lld сериалов из вашей облачной резервной копии.</string>
            <key>other</key>
            <string>Мы восстановили %lld сериала из вашей облачной резервной копии.</string>
        </dict>
    </dict>

    <!-- Shows added (onboarding) -->
    <key>plural_shows_added</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Добавлен %lld сериал. Мы будем следить за каждым сезоном и сообщим вам, когда его можно будет смотреть.</string>
            <key>few</key>
            <string>Добавлено %lld сериала. Мы будем следить за каждым сезоном и сообщим вам, когда их можно будет смотреть.</string>
            <key>many</key>
            <string>Добавлено %lld сериалов. Мы будем следить за каждым сезоном и сообщим вам, когда их можно будет смотреть.</string>
            <key>other</key>
            <string>Добавлено %lld сериала. Мы будем следить за каждым сезоном и сообщим вам, когда их можно будет смотреть.</string>
        </dict>
    </dict>

    <!-- Premieres in days -->
    <key>plural_premieres_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>ПРЕМЬЕРА ЧЕРЕЗ %lld ДЕНЬ</string>
            <key>few</key>
            <string>ПРЕМЬЕРА ЧЕРЕЗ %lld ДНЯ</string>
            <key>many</key>
            <string>ПРЕМЬЕРА ЧЕРЕЗ %lld ДНЕЙ</string>
            <key>other</key>
            <string>ПРЕМЬЕРА ЧЕРЕЗ %lld ДНЯ</string>
        </dict>
    </dict>

    <!-- Binge ready in days -->
    <key>plural_binge_ready_in_days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>В вашем расписании · готово к просмотру через ~%lld день</string>
            <key>few</key>
            <string>В вашем расписании · готово к просмотру через ~%lld дня</string>
            <key>many</key>
            <string>В вашем расписании · готово к просмотру через ~%lld дней</string>
            <key>other</key>
            <string>В вашем расписании · готово к просмотру через ~%lld дня</string>
        </dict>
    </dict>

    <!-- Episodes aired of total -->
    <key>plural_episodes_watched</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@watched@ из %#@total@ эпизодов просмотрено</string>
        <key>watched</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>few</key>
            <string>%lld</string>
            <key>many</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld</string>
            <key>few</key>
            <string>%lld</string>
            <key>many</key>
            <string>%lld</string>
            <key>other</key>
            <string>%lld</string>
        </dict>
    </dict>

    <!-- All episodes out -->
    <key>plural_all_episodes_out</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Вышел %lld эпизод · только что завершился</string>
            <key>few</key>
            <string>Вышли все %lld эпизода · только что завершился</string>
            <key>many</key>
            <string>Вышли все %lld эпизодов · только что завершился</string>
            <key>other</key>
            <string>Вышли все %lld эпизода · только что завершился</string>
        </dict>
    </dict>

    <!-- Follow line complete -->
    <key>plural_follow_line_complete</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld эпизод уже вышел — начинайте, когда захотите.</string>
            <key>few</key>
            <string>Все %lld эпизода уже вышли — начинайте, когда захотите.</string>
            <key>many</key>
            <string>Все %lld эпизодов уже вышли — начинайте, когда захотите.</string>
            <key>other</key>
            <string>Все %lld эпизода уже вышли — начинайте, когда захотите.</string>
        </dict>
    </dict>

    <!-- Follow hint airing -->
    <key>plural_follow_hint_airing</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Подпишитесь, и мы подождём %lld эпизод, а затем уведомим вас, когда его можно будет смотреть.</string>
            <key>few</key>
            <string>Подпишитесь, и мы подождём все %lld эпизода, а затем уведомим вас, когда их можно будет смотреть.</string>
            <key>many</key>
            <string>Подпишитесь, и мы подождём все %lld эпизодов, а затем уведомим вас, когда их можно будет смотреть.</string>
            <key>other</key>
            <string>Подпишитесь, и мы подождём все %lld эпизода, а затем уведомим вас, когда их можно будет смотреть.</string>
        </dict>
    </dict>

    <!-- Share default binged -->
    <key>plural_share_binged</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Только что посмотрел %lld эпизод от начала до конца.</string>
            <key>few</key>
            <string>Только что посмотрел все %lld эпизода от начала до конца.</string>
            <key>many</key>
            <string>Только что посмотрел все %lld эпизодов от начала до конца.</string>
            <key>other</key>
            <string>Только что посмотрел все %lld эпизода от начала до конца.</string>
        </dict>
    </dict>
